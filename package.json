{
  "name": "petarbyte-beats",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-audio-api": "~1.0.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "secretlint": "^14.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "prepare": "husky",
    "lint:secrets": "secretlint \"**/*\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.mp3$": "<rootDir>/tests/setup/audioAssetStub.ts",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "\\.cs$": "<rootDir>/config/jestTextTransformer.js"
    },
    "setupFiles": [
      "<rootDir>/tests/setup/audioApiMock.ts"
    ]
  },
  "lint-staged": {
    "*": [
      "secretlint",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0"
  }
}
